# Copy this file to apps/api/.env and adjust as needed for local dev.

# Postgres (matches infra/docker-compose.yml)
DATABASE_URL="postgresql://app:app@localhost:5432/threeby3?schema=public"

# JWT
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# MinIO (S3-compatible, local dev stand-in for Cloudflare R2)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET_VIDEOS="videos"
S3_BUCKET_CLIPS="clips"
S3_FORCE_PATH_STYLE="true"

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

# Mail (Mailhog in dev)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_FROM="noreply@3x3app.local"

# App
PORT="3000"
NODE_ENV="development"
APP_BASE_URL="http://localhost:5173"

# Seed
SEED_SUPERADMIN_EMAIL="admin@3x3app.local"
SEED_SUPERADMIN_PASSWORD="ChangeMe123!"
